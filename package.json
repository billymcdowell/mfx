{
	"name": "@billy_mcdowell/mfx",
	"version": "0.0.0",
	"description": "Terminal-native market dashboard CLI (Ink + React)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/billymcdowell/mfx.git"
	},
	"bugs": "https://github.com/billymcdowell/mfx/issues",
	"homepage": "https://github.com/billymcdowell/mfx#readme",
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"mfx": "dist/source/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc && tsc-alias -p tsconfig.json -f",
		"dev": "tsx watch source/cli.tsx",
		"build:watch": "tsc --watch --preserveWatchOutput",
		"test": "npm run build && ava",
		"lint": "prettier --check . && xo",
		"prepublishOnly": "npm run build",
		"release": "npm run build && changeset publish",
		"changeset": "changeset",
		"version-packages": "changeset version"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"cli-spinners": "^2.9.2",
		"figlet": "^1.11.0",
		"glob": "^13.0.6",
		"ink": "^7.0.3",
		"marked": "^18.0.3",
		"meow": "^11.0.0",
		"mnemonist": "^0.40.4",
		"react": "^19.2.0",
		"simple-ascii-chart": "^5.4.0",
		"strip-ansi": "^7.2.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.2",
		"@changesets/cli": "^2.29.8",
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/react": "^19.0.32",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.2.0",
		"chalk": "^5.2.0",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"ink-testing-library": "^3.0.0",
		"prettier": "^2.8.7",
		"ts-node": "^10.9.1",
		"tsc-alias": "^1.8.17",
		"tsx": "^4.19.4",
		"typescript": "^5.0.3",
		"xo": "^0.53.1"
	},
	"ava": {
		"files": [
			"test/**/*.mjs"
		],
		"extensions": {
			"js": true,
			"mjs": true
		},
		"nodeArguments": []
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off",
			"import/extensions": "off",
			"import/no-named-as-default": "off",
			"react/react-in-jsx-scope": "off",
			"react/prefer-read-only-props": "off",
			"react/function-component-definition": "off",
			"react/hook-use-state": "off",
			"react/state-in-constructor": "off",
			"@typescript-eslint/consistent-type-definitions": "off",
			"@typescript-eslint/member-ordering": "off",
			"@typescript-eslint/no-empty-function": "off",
			"@typescript-eslint/no-implicit-any-catch": "off",
			"@typescript-eslint/no-floating-promises": "off",
			"@typescript-eslint/no-unsafe-assignment": "off",
			"@typescript-eslint/no-unsafe-call": "off",
			"@typescript-eslint/prefer-nullish-coalescing": "off",
			"@typescript-eslint/prefer-optional-chain": "off",
			"@typescript-eslint/restrict-plus-operands": "off",
			"@typescript-eslint/restrict-template-expressions": "off",
			"react/boolean-prop-naming": "off",
			"n/prefer-global/process": "off",
			"n/prefer-global/buffer": "off",
			"react/no-array-index-key": "off",
			"react/no-unused-prop-types": "off",
			"react/require-default-props": "off",
			"no-bitwise": "off",
			"no-new-func": "off",
			"no-multi-assign": "off",
			"func-names": "off",
			"unicorn/no-array-callback-reference": "off",
			"unicorn/prefer-spread": "off",
			"unicorn/prefer-top-level-await": "off",
			"unicorn/prevent-abbreviations": "off"
		},
		"overrides": [
			{
				"files": [
					"**/*.ts",
					"**/*.tsx"
				],
				"rules": {
					"@typescript-eslint/naming-convention": "off"
				}
			}
		]
	},
	"prettier": "@vdemedes/prettier-config",
	"overrides": {
		"eslint-plugin-unicorn": "^52.0.0"
	}
}
